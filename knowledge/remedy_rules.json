{
  "version": "1.0-draft",
  "rules": [
    {
      "id": "R-01",
      "when": {
        "inquiry_type": "SIMPLE_TAX_QUESTION"
      },
      "primary_routes": [
        "국세상담센터 등 공식 세법 상담"
      ],
      "secondary_routes": [],
      "cautions": [
        "권리침해 또는 처분 문제가 확인되면 다시 분류합니다."
      ]
    },
    {
      "id": "R-02",
      "when": {
        "issue_types_any": [
          "신고 오류",
          "과다 신고"
        ]
      },
      "primary_routes": [
        "경정청구 등 신고 정정 절차 검토"
      ],
      "secondary_routes": [],
      "cautions": [
        "세목·신고 내용·기간 및 요건을 확인해야 합니다."
      ]
    },
    {
      "id": "R-03",
      "when": {
        "issue_types_any": [
          "미신고"
        ]
      },
      "primary_routes": [
        "기한후신고 등 검토"
      ],
      "secondary_routes": [],
      "cautions": [
        "적용 요건과 세액 관련 효과는 현행 규정 확인이 필요합니다."
      ]
    },
    {
      "id": "R-04",
      "when": {
        "issue_types_any": [
          "신고 후 자료 제출 요구"
        ]
      },
      "primary_routes": [
        "담당자에게 자료 요구의 취지·근거·제출기한 확인"
      ],
      "secondary_routes": [
        "신고내용 확인 절차인지 확인"
      ],
      "cautions": [
        "고지·처분 전이라는 이유만으로 경정청구나 불복을 확정 추천하지 않습니다."
      ]
    },
    {
      "id": "R-05",
      "when": {
        "notice_kind": "과세예고"
      },
      "primary_routes": [
        "과세전적부심사 등 검토"
      ],
      "secondary_routes": [],
      "cautions": [
        "청구 대상·예외·기간을 현행 규정으로 확인합니다."
      ]
    },
    {
      "id": "R-06",
      "when": {
        "notice_kind": "고지"
      },
      "primary_routes": [
        "과세처분 불복절차 검토"
      ],
      "secondary_routes": [
        "과세 근거 확인",
        "권리보호요청 대상 여부 검토"
      ],
      "cautions": [
        "처분 종류와 통지일에 따라 기한을 확인합니다."
      ]
    },
    {
      "id": "R-07",
      "when": {
        "issue_types_any": [
          "과세근거 안내 부족",
          "절차상 권리침해",
          "부당한 세무조사 행위"
        ]
      },
      "primary_routes": [
        "납세자보호담당관에게 권리보호요청 대상 여부 상담"
      ],
      "secondary_routes": [
        "과세처분이 있는 경우 불복 가능성 별도 확인"
      ],
      "cautions": [
        "권리보호요청이 불복절차나 불복기한을 자동으로 대체하지 않습니다."
      ]
    },
    {
      "id": "R-08",
      "when": {
        "tax_audit_status_any": [
          "착수",
          "진행"
        ]
      },
      "primary_routes": [
        "세무조사 관련 권리보호 절차 검토"
      ],
      "secondary_routes": [
        "담당 조사팀 또는 납세자보호담당관에 사실 확인"
      ],
      "cautions": [
        "구체적인 적용 대상과 예외를 확인합니다."
      ]
    },
    {
      "id": "R-09",
      "when": {
        "tax_audit_status": "종결"
      },
      "primary_routes": [
        "과세예고통지 또는 고지 여부를 먼저 확인"
      ],
      "secondary_routes": [],
      "cautions": [
        "조사 종결만으로 과세전적부심사나 조기결정신청을 자동 추천하지 않습니다."
      ]
    },
    {
      "id": "R-10",
      "when": {
        "collection_status_any": [
          "납부 곤란",
          "체납",
          "압류"
        ]
      },
      "primary_routes": [
        "징수유예 등 징수 관련 제도 검토"
      ],
      "secondary_routes": [],
      "cautions": [
        "체납 단계·압류 상태·신청 요건을 확인합니다."
      ]
    },
    {
      "id": "R-11",
      "when": {
        "appeal_status": "기한 경과 주장"
      },
      "primary_routes": [
        "처분일·통지일·처분 종류 및 기간 계산 확인"
      ],
      "secondary_routes": [
        "요건에 따라 고충민원 등 후속 절차 검토"
      ],
      "cautions": [
        "고충민원이 일반 불복절차를 대체하거나 처분 취소를 보장하지 않습니다."
      ]
    },
    {
      "id": "R-12",
      "when": {
        "issue_types_any": [
          "해결되지 않은 민원"
        ]
      },
      "primary_routes": [
        "고충민원·청원·국민신문고 등 적절한 후속 경로 검토"
      ],
      "secondary_routes": [],
      "cautions": [
        "각 절차의 대상과 법적 효과를 구분합니다."
      ]
    }
  ],
  "note": "초기 구현용 초안. 현행 법령·규정 검증 전 공식 판단에 사용하지 마세요."
}